# Modèle des réglages et secrets que le code lit. Aucune valeur ici.
# Les fichiers secrets vivent hors du dépôt (voir .gitignore).

# --- API (serveur/) ---
# Base de données : soit une URL complète, soit les morceaux ci-dessous.
BDD_URL=
BDD_HOTE=
BDD_PORT=
BDD_NOM=
BDD_UTILISATEUR=
# Fichier qui contient le mot de passe de la base (une ligne).
BDD_MDP_FICHIER=/secrets/bdd_mdp.txt

# Dossier des données (médias, avatars, clé YouTube facultative).
STATE_DIRECTORY=
# 0 en local sans HTTPS, 1 en production.
COOKIE_SECURE=1
URL_PUBLIQUE=

# Clé d'API YouTube, facultative : variable, ou fichier $STATE_DIRECTORY/cle_youtube.txt
YOUTUBE_API_KEY=

# Courriel : stdout (local, affiche le message), ou l'URL d'un relais HTTP.
MAIL_URL=stdout
# Fichier qui contient le jeton du relais de courriel.
MAIL_SECRET_FICHIER=/secrets/mail_secret.txt

# --- Service flux/ (facultatif, non branché) ---
# Fichier de cookies YouTube au format Netscape, monté en /secrets/cookies.txt
